{
  "name": "tiktok-pulse-desktop",
  "version": "0.1.0",
  "description": "TikTok Pulse desktop app (Windows + macOS)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "co.mofuli.tiktokpulse",
    "productName": "TikTok Pulse",
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "identity": null
    },
    "files": [
      "main.js",
      "ui/**/*"
    ]
  }
}
